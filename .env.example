# Local WS proxy for `npm run dev` / `npm run dev:full` (not needed on Vercel).
# NEXT_PUBLIC_WS_ORIGIN=ws://localhost:3001
# Optional port for scripts/ws-dev-server.ts (default 3001)
# WS_DEV_PORT=3001

# Azure AI Speech resource (Portal → Speech → Keys and Endpoint)
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=eastasia

# Google Cloud (Speech-to-Text V2 + Cloud Translation)
# 1) Create a GCP project and enable:
#    - Cloud Speech-to-Text API
#    - Cloud Translation API
# 2) Create a service account with those roles, download JSON key
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
# Local path to service-account JSON (dev machine):
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Or paste the entire JSON as one line for Vercel / serverless:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Optional: Speech V2 location (default global). Chirp-only regions e.g. us-central1
# GOOGLE_SPEECH_LOCATION=global

# Deepgram (live STT) — https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key
# Optional model (default nova-2)
# DEEPGRAM_MODEL=nova-2

# AssemblyAI (live STT v3) — https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
# Optional speech model (default universal-3-6-pro; supports zh/yue/ko/ja…)
# universal-streaming-multilingual only supports EN/ES/DE/FR/PT/IT — do not use for Chinese.
# ASSEMBLYAI_SPEECH_MODEL=universal-3-6-pro

# Translation backend for Deepgram / AssemblyAI (shared):
# Prefer DeepL if set; otherwise Google Cloud Translation (GOOGLE_* above).
# DeepL free keys usually end with :fx → uses api-free.deepl.com
# DEEPL_API_KEY=your_deepl_api_key:fx

# Cloudflare Workers AI (Nova-3 WebSocket STT + m2m100 translation)
# Dashboard → Workers AI → Use REST API → create token + copy Account ID
# https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_workers_ai_api_token
# Optional: use AI Gateway realtime path instead of account REST WS
# CLOUDFLARE_AI_GATEWAY=your_gateway_name
